  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "No campo onde o vento decide dan\xE7ar,\nergue-se uma casa pintada de
    esperan\xE7a,\nfolhas e paredes dividem o mesmo tom.\n\nLogo adiante, repousa
    uma morada sem vaidade,\nparede nua, porta simples, ch\xE3o de p\xF3.\n\nMais
    al\xE9m, tentando tocar estrelas,\numa torre sobe como prece de pedra,\nsonhando
    com luas que nunca alcan\xE7a.\n\nE no fim da estrada, sentinela do sil\xEAncio,\numa
    torre que vigia o horizonte,\nolhos de janela, guardi\xE3 do p\xF4r do sol."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
