  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 367ad717683bf1142b71d7eee7510893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  textoPT: "N\xE3o sei por que ainda escrevo. Minhas m\xE3os tremem como se meus
    ossos j\xE1 n\xE3o fossem meus.\n\nMas n\xE3o h\xE1 risos onde estou. O sil\xEAncio
    me observa, a casa me mastiga.\n\n"
  textoEN: 'I don''t know why I still write.

    My hands tremble as if my bones
    were no longer my own.


    But there is no laughter where I am.

    The silence
    watches me, the house chews me up.'
  useLayoutOverride: 0
  ptAnchoredPosition: {x: 0, y: 0}
  ptScale: {x: 1, y: 1, z: 1}
  enAnchoredPosition: {x: 0, y: 0}
  enScale: {x: 1, y: 1, z: 1}
