  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A cada passo, eu escuto aquele dia repetindo em minha cabe\xE7a: ela dizendo
    que me amava, e eu acreditando que amor \xE9 posse.\n\nSe ela estivesse viva,
    ter\xEDamos celebrado 12 anos juntos...\n\n"
