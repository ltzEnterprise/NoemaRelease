  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  textoPT: "Perfeita como algo que n\xE3o pode sair da prateleira.\n\nE quando ela
    tentou\u2026 eu a coloquei de volta no lugar.\n\nO amor \xE9 um castigo quando
    se ama s\xF3 a si mesmo."
  textoEN: "Perfect like something that cannot leave the shelf.\n\nAnd when she tried\u2026
    I put her back in her place.\n\nLove is a punishment when you only love yourself."
  useLayoutOverride: 0
  ptAnchoredPosition: {x: 0, y: 0}
  ptScale: {x: 1, y: 1, z: 1}
