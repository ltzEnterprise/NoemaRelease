  m_Script: {fileID: 11500000, guid: 367ad717683bf1142b71d7eee7510893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  textoPT: "A cada passo, eu escuto aquele dia repetindo em minha cabe\xE7a: ela
    dizendo que me amava, e eu acreditando que amor \xE9 posse.\n\nSe ela estivesse
    viva, ter\xEDamos celebrado 9 anos juntos...\n\n"
  textoEN: 'With every step, I hear that day repeating in my head: her telling me
    she loved me, and me believing that love is possession.


    If she were alive,
    we would have celebrated 9 years together...'
  useLayoutOverride: 0
  ptAnchoredPosition: {x: 0, y: 0}
  ptScale: {x: 1, y: 1, z: 1}
  enAnchoredPosition: {x: 0, y: 0}
  enScale: {x: 1, y: 1, z: 1}
