      value: '[E] para ler a folha'
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_text
      value: "Hoje \xE9 21.\nEla adorava o n\xFAmero 21, dizia que dava sorte.\n\nMas
        n\xE3o existe sorte nesse lugar.\n\nEu n\xE3o consigo morrer.\nEu n\xE3o
        consigo comer.\nS\xF3 sinto a dor da fome, todos os dias.\n\nO rel\xF3gio
        parou.\n\xC9 1997\u2026 ou 1998?\nOu ser\xE1 que o tempo est\xE1 zombando
        de mim?\n\nEu a vejo me olhando pelas paredes.\nEla sabe que eu sei.\nEu
        sei que ela sabe.\n\neu fiz aquilo por amor."
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_sharedMaterial
