      objectReference: {fileID: 0}
    - target: {fileID: 3507879944076858780, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_text
      value: '[E] para ler a folha'
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_text
      value: "N\xE3o sei por que ainda escrevo. Minhas m\xE3os tremem como se meus
        ossos j\xE1 n\xE3o fossem meus.\n\nMas n\xE3o h\xE1 risos onde estou. O sil\xEAncio
        me observa, a casa me mastiga.\n\nA cada passo, eu escuto aquele dia repetindo
        em minha cabe\xE7a: ela dizendo que me amava, e eu acreditando que amor \xE9
        posse.\n\nSe ela estivesse Viva, ter\xEDamos celebrado 12 anos juntos...\n\nMas
        ela n\xE3o est\xE1. E eu continuo aqui. Preso ao que fiz.\n\nPor que o Diabo
        n\xE3o me leva logo?"
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_sharedMaterial
      value: 
      objectReference: {fileID: 2100000, guid: 79459efec17a4d00a321bdcc27bbc385, type: 2}
    - target: {fileID: 6007283103299691164, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_Name
      value: "Investiga\xE7\xE3o1 (2)"
      objectReference: {fileID: 0}
    - target: {fileID: 6007283103299691164, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_IsActive
