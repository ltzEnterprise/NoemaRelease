      objectReference: {fileID: 0}
    - target: {fileID: 3507879944076858780, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_text
      value: '[E] para ler a folha'
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_text
      value: "Eu lembro vividamente\u2026\nO primeiro inverno juntos.\nEla comemorava
        25 anos quando eu me ajoelhei e pedi sua m\xE3o.\n\nEla disse sim.\n\nUma
        semana depois, viajamos com a fam\xEDlia dela para celebrar o Natal, e ela
        dizia que aquele seria o in\xEDcio de uma vida perfeita.\n\nPerfeita\u2026\n\nPerfeita
        como uma boneca.\n\nPerfeita como algo que n\xE3o pode sair da prateleira.\n\nE
        quando ela tentou\u2026 eu a coloquei de volta no lugar.\n\nO amor \xE9 um
        castigo quando se ama s\xF3 a si mesmo."
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_fontSize
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 4400978573317138966, guid: 177bb73b0907cd14998e82db6317f9fb, type: 3}
      propertyPath: m_fontSizeBase
