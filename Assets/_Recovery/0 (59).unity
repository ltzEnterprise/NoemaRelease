--- !u!114 &62573216
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 62573211}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 367ad717683bf1142b71d7eee7510893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  textoPT: "A alavanca ao lado do Ba\xFA deve estar ligada.\n\nA Chave n\xE3o pode
    estar ligada se o Ba\xFA estiver desligado.\n\nO Rum deve estar desligado se
    estiver ao lado do Barco.\n\nA \xC2ncora e a B\xFAssola nunca podem estar ligadas
    ao mesmo tempo.\n\nExatamente tr\xEAs alavancas devem estar ligadas.\n\nO Ba\xFA
    tem que estar desligado se a \xC2ncora estiver ligada."
  textoEN: 'The lever next to the Chest must be on.


    The Key cannot be on if
    the Chest is off.


    The Rum must be off if it is next to the Boat.


    The
    Anchor and the Compass can never be on at the same time.


    Exactly three
    levers must be on.


    The Chest must be off if the Anchor is on.'
  useLayoutOverride: 0
  ptAnchoredPosition: {x: 0, y: 0}
  ptScale: {x: 1, y: 1, z: 1}
  enAnchoredPosition: {x: 0, y: 0}
  enScale: {x: 1, y: 1, z: 1}
