--- !u!114 &181502003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 181502000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0afb27daa3633c458375a92893d4eb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortaComSenha
  uniqueID: 8bbb19e5-e213-4d12-b415-b2e3b0dde5e0
  idDessaCasa: 1
  senhaCorreta: 23195
  darChaveAoResolver: 1
  idChaveRecompensa: KeyShip
  imagemChaveNoInventario: {fileID: 339942692}
  introducao:
  - texto: "Olha quem est\xE1 de volta..."
    textoEN: 'Look who has returned...

'
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.5
  - texto: "N\xE3o posso dizer o mesmo de voc\xEA sabe quem..."
    textoEN: "I can\u2019t say the same for you-know-who...\n"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 1.3
  - texto: "Voc\xEA pelo menos lembra da hist\xF3ria que sua filha adorava?"
    textoEN: Do you even remember the story your daughter loved?
    tamanhoDaFonte: 16
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.3
  poemaDoFantasma:
  - texto: "\"Quando a noite ca\xEDa, uma garotinha tentava contar todas as estrelas
      do c\xE9u.\""
    textoEN: '"When night fell, a little girl tried to count all the stars in the
      sky."'
    tamanhoDaFonte: 16
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 3
  - texto: "\"Ela n\xE3o sabia que havia tantas estrelas quanto gotas de chuva.\""
    textoEN: "\"She didn\u2019t know there were as many stars as there are raindrops.\""
    tamanhoDaFonte: 16
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 3
  - texto: "\"\xC0 luz do luar, aprendia que algumas nascem enquanto outras morrem.\""
    textoEN: '"In the moonlight, she learned that some are born while others die."'
    tamanhoDaFonte: 14
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 3
  - texto: "\"E quando o sol surgia, o ciclo come\xE7ava outra vez.\""
    textoEN: '"And when the sun rose, the cycle began once more."'
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 3
  complemento:
  - texto: "Ela adorava esconder c\xF3digos em tudo."
    textoEN: She loved hiding codes in everything.
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1
  - texto: "Se voc\xEA foi um bom pai, me diga a resposta do enigma dela."
    textoEN: If you were a good father, tell me the answer to her riddle.
    tamanhoDaFonte: 16
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1
  objetoAcertou: {fileID: 1690075346}
  objetoErrou: {fileID: 1838384579}
  painelTelaPreta: {fileID: 1835704551}
