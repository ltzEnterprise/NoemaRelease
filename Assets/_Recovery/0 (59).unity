  senhaCorreta: 4797
  idDoDiscoParaDar: 9
  dicaApertarR: "[R] Repetir o di\xE1logo"
  dicaApertarREN: '[R] Repeat voices'
  falasDaPorta:
  - texto: "Perdido nesse mundo, existe uma sequ\xEAncia musical..."
    textoEN: Lost in this world, there is a musical sequence...
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1
  - texto: "Ela esconde um c\xF3digo num\xE9rico."
    textoEN: It hides a numerical code.
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.06
    tempoDeEsperaApos: 1
  - texto: "A senha \xE9 4 10 18 7."
    textoEN: The password is 4 10 18 7.
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 2
