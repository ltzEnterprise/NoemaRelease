  m_Script: {fileID: 11500000, guid: 872765e310f569145b39a1c721903f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortaQuiz
  uniqueID: b6928139-5289-41e0-8c64-8c0f4b4aafbf
  idDessaCasa: 2
  idItemPremio: 5
  bancoDePerguntas:
  - enunciado: "Quantas \xE1rvores m\xE1gicas existem?"
    enunciadoEN: How many magical trees are there?
    tamanhoDaFonte: 18
    alternativas:
    - 6
    - 2
    - 3
    - 4
    alternativasEN:
    - 6
    - 2
    - 3
    - 4
    indiceCorreta: 2
  - enunciado: "Quantos canh\xF5es est\xE3o na superf\xEDcie do navio?"
    enunciadoEN: How many cannons are on the surface of the ship?
    tamanhoDaFonte: 18
    alternativas:
    - 6
    - 8
    - 11
    - 13
    alternativasEN:
    - 6
    - 8
    - 11
    - 13
    indiceCorreta: 1
  - enunciado: "Qual era o nome do capit\xE3o do navio Aurora Negra?"
    enunciadoEN: What was the name of the captain of the ship Black Aurora?
    tamanhoDaFonte: 18
    alternativas:
    - John Delacruz
    - Bartholomew
    - Jackson Pary
    - William Turber
    alternativasEN:
    - John Delacruz
    - Bartholomew
    - Jackson Pary
    - William Turber
    indiceCorreta: 0
  - enunciado: "Qual \xE9 a senha desses port\xF5es de tr\xE1s pra frente invertido
      ao contr\xE1rio?"
    enunciadoEN: What is the password of these gates, backwards, inverted, and reversed?
    tamanhoDaFonte: 18
    alternativas:
    - 1487
    - 7841
    - 1741
    - 7418
    alternativasEN:
    - 1487
    - 7841
    - 1741
    - 7418
    indiceCorreta: 1
  - enunciado: "Qual dire\xE7\xE3o est\xE1 localizado uma cadeira de praia?"
    enunciadoEN: In which direction is a beach chair located?
    tamanhoDaFonte: 18
    alternativas:
    - Sul
    - Norte
    - Leste
    - Oeste
    alternativasEN:
    - South
    - North
    - East
    - West
    indiceCorreta: 1
  - enunciado: "Me diga o c\xF3digo secreto das torres desse castelo."
    enunciadoEN: Tell me the secret code of the towers of this castle.
    tamanhoDaFonte: 18
    alternativas:
    - 9.318.054
    - 11.768.044
    - 6.296.137
    - 3.110.325
    alternativasEN:
    - 9.318.054
    - 11.768.044
    - 6.296.137
    - 3.110.325
    indiceCorreta: 0
  - enunciado: "Responda em Axidral qual sua pr\xF3pria estrutura est\xE1vel?"
    enunciadoEN: Answer in Axidral what is your own stable structure?
    tamanhoDaFonte: 18
    alternativas:
    - AABBABAA
    - BBAABABB
    - ABBAABAB
    - BBAABBAB
    alternativasEN:
    - AABBABAA
    - BBAABABB
    - ABBAABAB
    - BBAABBAB
    indiceCorreta: 0
  - enunciado: "Quantas runas m\xE1gicas existem?"
    enunciadoEN: How many magical runes are there?
    tamanhoDaFonte: 18
    alternativas:
    - 5
    - 8
    - 6
    - 9
    alternativasEN:
    - 5
    - 8
    - 6
    - 9
    indiceCorreta: 3
  - enunciado: "Que horas s\xE3o nesse mundo?"
    enunciadoEN: 'What time is it in this world?

'
    tamanhoDaFonte: 18
    alternativas:
    - 09:30
    - 10:25
    - 13:40
    - 07:25
    alternativasEN:
    - 09:30
    - 10:25
    - 13:40
    - 07:25
    indiceCorreta: 2
  - enunciado: Qual o nome desse mundo?
    enunciadoEN: What is the name of this world?
    tamanhoDaFonte: 18
    alternativas:
    - Liminal
    - Sominum
    - Dream
    - Noema
    alternativasEN:
    - Liminal
    - Sominum
    - Dream
    - Noema
    indiceCorreta: 3
  introducao:
  - texto: Eu sou o PORTEIRO
    textoEN: I am the GATEKEEPER
    tamanhoDaFonte: 27
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA acha que conhece bem a sua PR\xD3PRIA mente?"
    textoEN: Do you think you truly know your OWN mind?
    tamanhoDaFonte: 27
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA ter\xE1 que acertar minhas perguntas se quiser sair desse sono
      profundo."
    textoEN: You will have to answer my questions if you want to escape this deep
      sleep.
    tamanhoDaFonte: 27
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA n\xE3o tem escolha a n\xE3o ser responder..."
    textoEN: You have no choice but to answer...
    tamanhoDaFonte: 27
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 2
