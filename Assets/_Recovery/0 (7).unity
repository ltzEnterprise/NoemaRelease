--- !u!114 &181502003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 181502000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0afb27daa3633c458375a92893d4eb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortaComSenha
  idDessaCasa: 1
  senhaCorreta: 23195
  idItemEscada: 6
  introducao:
  - texto: "Olha quem est\xE1 de volta..."
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.5
  - texto: "N\xE3o posso dizer o mesmo de voc\xEA sabe quem."
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 1.3
  - texto: "Voc\xEA pelo menos lembra da hist\xF3ria que sua filha adorava?"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.3
  poemaDoFantasma:
  - texto: "\"Quando a noite ca\xEDa, uma garotinha tentava contar todas as estrelas
      do c\xE9u.\""
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "\"Ela n\xE3o sabia que havia tantas estrelas quanto gotas de chuva.\""
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "\"\xC0 luz do luar, aprendia que algumas nascem enquanto outras morrem.\""
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "\"E quando o sol surgia, o ciclo come\xE7ava outra vez.\""
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 4
  complemento:
  - texto: "Ela adorava esconder c\xF3digos em tudo."
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1
  - texto: "Se voc\xEA foi um bom pai, me diga a resposta do enigma dela."
    tamanhoDaFonte: 16
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1
  textoSucesso: A alma te presenteou com uma escada velha.
  textoErro: "Voc\xEA est\xE1 errado..."
  painelTelaPreta: {fileID: 1835704551}
  textoDialogoCutscene: {fileID: 1824620454}
  textoInteragir: {fileID: 1143060683}
  painelSenha: {fileID: 1835704551}
  textoDisplaySenha: {fileID: 58417251}
  textoInstrucaoFeedback: {fileID: 0}
  textoAvisoBotaoR: {fileID: 876155253}
  audioSourceSFX: {fileID: 181502002}
  audioSourceVoz: {fileID: 181502002}
  audioSourceMusica: {fileID: 181502002}
  somBatida: {fileID: 8300000, guid: 0b2ff79606ff07b4c846e9bc99b05485, type: 3}
  somPortaAbrindo: {fileID: 8300000, guid: f767873a68e8f7a43992479695d19839, type: 3}
  somDigitando: {fileID: 8300000, guid: 7805f1431786d6445897bf8a3adfa2d8, type: 3}
