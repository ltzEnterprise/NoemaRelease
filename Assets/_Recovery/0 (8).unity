  falasLoucura:
  - texto: "O QUE VOC\xCA T\xC1 FAZENDO AQUI?"
    velocidadeDigitar: 0.07
    tempoDeEsperaApos: 1.2
  - texto: "EST\xC1 PRESO NA SUA PR\xD3PRIA PRIS\xC3O?"
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 1.13
  - texto: EU TENHO QUE SAIR DAQUI
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.37
  - texto: EU PRECISO CAVAR...
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 1.39
  - texto: E CAVAR...
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 0.78
  - texto: "O INFERNO PODE SER A SA\xCDDA DESSE INFERNO"
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 1.5
