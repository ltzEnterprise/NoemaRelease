  m_Script: {fileID: 11500000, guid: 872765e310f569145b39a1c721903f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortaQuiz
  idDessaCasa: 2
  idItemPremio: 1
  bancoDePerguntas:
  - enunciado: "Quantas \xE1rvores m\xE1gicas existem?"
    tamanhoDaFonte: 18
    alternativas:
    - 67
    - 2
    - 3
    - 4
    indiceCorreta: 2
  - enunciado: "Quantos canh\xF5es est\xE3o na superf\xEDcie do navio?"
    tamanhoDaFonte: 18
    alternativas:
    - 6
    - 9
    - 11
    - 13
    indiceCorreta: 2
  - enunciado: Quantos anos tinha a esposa do homem aprisionado?
    tamanhoDaFonte: 18
    alternativas:
    - 37
    - 39
    - 60
    - 36
    indiceCorreta: 0
  - enunciado: "Qual \xE9 a senha desses port\xF5es de tr\xE1s pra frente invertido
      ao contr\xE1rio?"
    tamanhoDaFonte: 18
    alternativas:
    - 1487
    - 7841
    - 1741
    - 7418
    indiceCorreta: 1
  - enunciado: "Que horas s\xE3o nesse mundo?"
    tamanhoDaFonte: 18
    alternativas:
    - 2:08
    - 12:02
    - 13:40
    - 11:35
    indiceCorreta: 2
  - enunciado: "Qual a combina\xE7\xE3o que se esconde no X da torre?"
    tamanhoDaFonte: 18
    alternativas:
    - 9.318.054
    - 11.768.044
    - 6.296.137
    - 3.110.325
    indiceCorreta: 0
  - enunciado: "Qual \xE9 o c\xF3digo do mist\xE9rio?"
    tamanhoDaFonte: 18
    alternativas:
    - CECBDB
    - DCEBCE
    - ECEBBD
    - CECDBD
    indiceCorreta: 3
  - enunciado: "Quantas runas m\xE1gicas existem?"
    tamanhoDaFonte: 18
    alternativas:
    - 5
    - 8
    - 6
    - 7
    indiceCorreta: 3
  - enunciado: Qual o total de perguntas que vou te fazer?
    tamanhoDaFonte: 18
    alternativas:
    - 1
    - 5
    - 10
    - 8
    indiceCorreta: 2
  - enunciado: "Quantas janelas t\xEAm a casa verde?"
    tamanhoDaFonte: 18
    alternativas:
    - 8
    - 12
    - 9
    - 11
    indiceCorreta: 1
  introducao:
  - texto: "Voc\xEA acha que conhece bem a sua pr\xF3pria mente?"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Que tal umas perguntinhas pra saber se voc\xEA realmente merece sair
      desse sono profundo?"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA n\xE3o tem escolha a n\xE3o ser responder..."
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 2
