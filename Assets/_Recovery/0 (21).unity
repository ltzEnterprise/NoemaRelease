  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortaQuiz
  modoDemo: 1
  scriptPortaCastelo: {fileID: 216131161}
  uniqueID: b6928139-5289-41e0-8c64-8c0f4b4aafbf
  idDessaCasa: 2
  idItemPremio: 1
  bancoDePerguntas:
  - enunciado: "Quantas \xE1rvores m\xE1gicas existem?"
    tamanhoDaFonte: 18
    alternativas:
    - 67
    - 2
    - 3
    - 4
    indiceCorreta: 2
  - enunciado: "Quantos canh\xF5es est\xE3o na superf\xEDcie do navio?"
    tamanhoDaFonte: 18
    alternativas:
    - 6
    - 9
    - 11
    - 13
    indiceCorreta: 1
  - enunciado: "Qual era o nome do capit\xE3o do navio Aurora Negra?"
    tamanhoDaFonte: 18
    alternativas:
    - John Delacruz
    - Jonatham Folige
    - John Hanks
    - Willian Turber
    indiceCorreta: 0
  - enunciado: "Qual \xE9 a senha desses port\xF5es de tr\xE1s pra frente invertido
      ao contr\xE1rio?"
    tamanhoDaFonte: 18
    alternativas:
    - 1487
    - 7841
    - 1741
    - 7418
    indiceCorreta: 1
  - enunciado: "Que horas s\xE3o nesse mundo?"
    tamanhoDaFonte: 18
    alternativas:
    - 2:08
    - 12:02
    - 13:40
    - 11:35
    indiceCorreta: 2
  - enunciado: "Me diga o c\xF3digo secreto das torres desse castelo."
    tamanhoDaFonte: 18
    alternativas:
    - 9.318.054
    - 11.768.044
    - 6.296.137
    - 3.110.325
    indiceCorreta: 0
  - enunciado: "Responda em Axidral qual sua pr\xF3pria estrutura est\xE1vel?"
    tamanhoDaFonte: 18
    alternativas:
    - GGIIGIGG
    - IIGGIGII
    - GIIGIGGI
    - GGIIGGII
    indiceCorreta: 0
  - enunciado: "Quantas runas m\xE1gicas existem?"
    tamanhoDaFonte: 18
    alternativas:
    - 5
    - 8
    - 6
    - 9
    indiceCorreta: 3
  - enunciado: Qual o total de perguntas que vou te fazer?
    tamanhoDaFonte: 18
    alternativas:
    - 1
    - 5
    - 10
    - 8
    indiceCorreta: 2
  - enunciado: Qual o nome desse mundo?
    tamanhoDaFonte: 18
    alternativas:
    - Liminal
    - Sominum
    - Dream
    - Noema
    indiceCorreta: 1
  introducao:
  - texto: Eu sou o PORTEIRO
    tamanhoDaFonte: 20
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA acha que conhece bem a sua PR\xD3PRIA mente?"
    tamanhoDaFonte: 20
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA ter\xE1 que acertar minhas perguntas se quiser sair desse sono
      profundo."
    tamanhoDaFonte: 20
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 2
  - texto: "Voc\xEA n\xE3o tem escolha a n\xE3o ser responder..."
    tamanhoDaFonte: 20
    velocidadeDigitar: 0.08
