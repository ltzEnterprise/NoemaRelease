  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ent\xE3o o capit\xE3o apareceu.\n\nOs olhos dele n\xE3o tinham mais nada
    humano. Lutou como um animal encurralado, l\xE2mina contra tr\xEAs, quatro homens.
    John viu dois ca\xEDrem antes de atravessarem o peito do capit\xE3o.\n\nCaindo
    de joelhos, Delacruz riu com sangue nos dentes.\n\nDo casaco, tirou uma concha
    negra, espiralada, viva como se respirasse. Antes que algu\xE9m entendesse, ele
    a lan\xE7ou ao mar.\n\nO oceano respondeu.\n\nPrimeiro, o navio parou. Ap\xF3s
    isso, tent\xE1culos maiores que mastros emergiram, e o mundo virou \xE1gua, madeira
    quebrando e homens gritando.\n\nMas John n\xE3o morreu afogado. Ele se levanta\n
    e v\xEA o c\xE9u roxo. O mar, im\xF3vel como vidro. O Aurora Negra estava preso
    em um limbo.\n\nO kraken n\xE3o os devorou. Ele os guardou.\nO navio ficou aprisionado
    nos sonhos da criatura"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 57e634bc06c699c45a79e69dea82c9ca, type: 2}
