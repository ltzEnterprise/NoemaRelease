  uniqueID: d6faaf8d-bc33-4f21-8eea-5b7c70ea2847
  idDessaCasa: 0
  idDaPaNoInventario: 4
  idDoDiscoParaDar: 2
  falasLoucura:
  - texto: "O QUE VOC\xCA T\xC1 FAZENDO AQUI?"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.07
    tempoDeEsperaApos: 1.2
  - texto: "EST\xC1 PRESO NA SUA PR\xD3PRIA PRIS\xC3O?"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.08
    tempoDeEsperaApos: 1.13
  - texto: EU TENHO QUE SAIR DAQUI
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 1.37
  - texto: EU PRECISO CAVAR...
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 1.39
  - texto: E CAVAR...
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 0.78
  - texto: "O INFERNO PODE SER A SA\xCDDA DESSE INFERNO"
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.1
    tempoDeEsperaApos: 1.5
  falasComPa:
  - texto: "Havia uma alma nessa casa que necessitava de uma p\xE1."
    tamanhoDaFonte: 18
    velocidadeDigitar: 0.04
    tempoDeEsperaApos: 4
  mensagemEntregaPa: "Voc\xEA entregou sua p\xE1 para a alma."
  mensagemDeuses: Os deuses te presentearam com um disco musical
