  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sentinelas do Vazio\n\nNo campo onde o vento decide dan\xE7ar,\nergue-se
    uma casa pintada de esperan\xE7a,\nfolhas e paredes dividem o mesmo tom.\n\n\nLogo
    adiante, repousa uma morada sem \nvaidade, parede nua, porta simples, \nch\xE3o
    de p\xF3.\n\n\nMais al\xE9m, tentando tocar estrelas,\numa torre sobe como prece
    de pedra,\nsonhando com luas que nunca alcan\xE7a.\n\n\nE no fim da estrada,
    sentinela do sil\xEAncio,\numa torre que vigia o horizonte,\nolhos de janela,
    guardi\xE3 do p\xF4r do sol, \ntrancada pelo plasma."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 57e634bc06c699c45a79e69dea82c9ca, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 57e634bc06c699c45a79e69dea82c9ca, type: 2}
